{
    "manifest_version": 3,
  "name": "blocker",
  "version": "1.0",
  "description": "A block url",
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": [
                "https://www.youtube.com/*"],
    "js": ["index.js"]
  }],
  "permissions":[
    "storage"
  ]
}